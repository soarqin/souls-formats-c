# Mini-XML — activated in Phase 4 (PARAMDEF XML reader).
#
# mxml ships an autoconf build; we don't want to invoke it cross-compiled.
# Instead, we download the sources via CPM, generate a minimal `config.h`
# tailored to a single-threaded static library, and compile the eight
# core `.c` files ourselves into an INTERFACE-friendly static target.
include_guard(GLOBAL)

CPMAddPackage(
    NAME mxml
    VERSION 4.0.4
    GITHUB_REPOSITORY michaelrsweet/mxml
    DOWNLOAD_ONLY YES
)

if(NOT mxml_ADDED)
    message(FATAL_ERROR "CPM failed to download mxml; run cmake --fresh to retry.")
endif()

# Generate a config.h that disables pthreads (single-threaded use is fine
# for our XML readers) and leaves `inline` enabled. Place the generated
# header in the CPM build dir so it doesn't pollute the source tree.
set(_sf_mxml_config_dir "${CMAKE_CURRENT_BINARY_DIR}/mxml-config")
file(MAKE_DIRECTORY "${_sf_mxml_config_dir}")
file(WRITE "${_sf_mxml_config_dir}/config.h"
"/* Generated by cmake/deps/mxml.cmake for souls-formats-c. */
#ifndef MXML_CONFIG_H
#define MXML_CONFIG_H
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <ctype.h>
#ifdef _WIN32
#  include <io.h>   /* read(), write() used by mxml-file.c on Windows */
#endif
#define MXML_VERSION \"Mini-XML v4.0.4\"
/* HAVE_PTHREAD_H intentionally undefined — single-threaded use. */
#endif /* MXML_CONFIG_H */
")

set(_sf_mxml_sources
    "${mxml_SOURCE_DIR}/mxml-attr.c"
    "${mxml_SOURCE_DIR}/mxml-file.c"
    "${mxml_SOURCE_DIR}/mxml-get.c"
    "${mxml_SOURCE_DIR}/mxml-index.c"
    "${mxml_SOURCE_DIR}/mxml-node.c"
    "${mxml_SOURCE_DIR}/mxml-options.c"
    "${mxml_SOURCE_DIR}/mxml-private.c"
    "${mxml_SOURCE_DIR}/mxml-search.c"
    "${mxml_SOURCE_DIR}/mxml-set.c"
)

add_library(mxml_static STATIC ${_sf_mxml_sources})
target_include_directories(mxml_static
    PUBLIC  "${mxml_SOURCE_DIR}"
    PRIVATE "${_sf_mxml_config_dir}"
)
set_target_properties(mxml_static PROPERTIES
    POSITION_INDEPENDENT_CODE ON
    C_STANDARD 99
    OUTPUT_NAME mxml4
)
# Upstream mxml is not warning-clean under -Wall -Wextra; we don't want
# the third-party noise breaking -Werror in our project. Strip warning
# flags only for this target.
if(NOT MSVC)
    target_compile_options(mxml_static PRIVATE -w)
else()
    target_compile_options(mxml_static PRIVATE /w)
endif()
